BACKEND=llama
#BACKEND=ollama
# LLAMA_URL=http://127.0.0.1:8080
# OLLAMA_URL=http://127.0.0.1:11434
# LLAMA_URL=http://host.docker.internal:8080
LLAMA_URL=http://model:8080
OLLAMA_URL=http://host.docker.internal:11434
API_KEYS=dev-key-123,internal-abc
# NOTE: Keep high in local docker to avoid 429 during automated chat tests.
RATE_LIMIT=300
ALLOW_ORIGINS=http://localhost:5173,http://localhost:8081
PORT=9000

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# PostgreSQL Configuration
DATABASE_URL=postgresql://sun_user:sun_pass_2026@postgres:5432/sun_mes
DATABASE_ENABLED=true

CSV_DATA_PATH=Backend/data
EXTERNAL_API_BASE_URL=http://58.84.1.104:9082
EXTERNAL_API_PREFIX=/api/rest/v1
EXTERNAL_API_TIMEOUT=120
EXTERNAL_API_RETRIES=2
MES_DEBUG_ROWS=0
PLANNER_DEBUG_AGG=0
# Local timezone offset for grouping timestamps that are returned in UTC (e.g., 7 for GMT+7)
LOCAL_TZ_OFFSET_HOURS=7
# Prefer a single JSON mapping for multi-factory routing (no per-factory hardcoded env var names)
MES_FACTORY_BASE_URLS={"FAC01":"http://58.84.1.104:9082","DJVN1":"http://58.84.1.104:9083"}

# Optional per-factory default query params for MES endpoints.
# Keep this minimal to avoid hard-coding org-chart details that may change.
# Suggested defaults:
# - factoryPks: factory scope
# - state: e.g. RUNNING
MES_FACTORY_DEFAULT_PARAMS={"FAC01":{"state":"RUNNING","factoryPks":"FAC01-6"},"DJVN1":{"state":"RUNNING","factoryPks":"DJVN1-13"}}
# External API token (DO NOT commit real tokens). Set this locally in your environment.
EXTERNAL_API_TOKEN=eyJhbGciOiJIUzI1NiJ9.eyJmYWN0b3J5Q29kZSI6IkZBQzAxIiwidXNlcklkIjo4MywiaWF0IjoxNjgwMDU5MzI0LCJ1c2VybmFtZSI6IlJFQUxfVElNRV9TRVJWSUNFQGdtYWlsLmNvbSJ9.NtwTYmIbgrf5LYtTknOsKONa3SV43XgK32NjQhyYjOU
# Some MES gateways require a feature code (header/query param). Set this to the value provided by MES.
EXTERNAL_API_FEATURE_CODE=user.create
MES_TEST_URL=http://mes-test:5000/report
